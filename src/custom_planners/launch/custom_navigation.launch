<?xml version="1.0"?>
<launch>

  <!-- ========================= -->
  <!--        ARGUMENTS          -->
  <!-- ========================= -->
  <arg name="algorithm" default="greedy"/>   <!-- astar / dijkstra / greedy -->
  <arg name="open_rviz" default="true"/>
  <arg name="model" default="$(env TURTLEBOT3_MODEL)"/>
  <arg name="map_file" default="/home/ubuntu/workspace/maps/labyrinthe_map.yaml"/>
  <arg name="move_forward_only" default="false"/>
  <arg name="initial_pose_x" default="0.0"/>
  <arg name="initial_pose_y" default="0.0"/>
  <arg name="initial_pose_a" default="0.0"/>

  <!-- ========================= -->
  <!--        MAP SERVER         -->
  <!-- ========================= -->
  <node pkg="map_server" type="map_server" name="map_server"
        args="$(arg map_file)" output="screen"/>

  <!-- ========================= -->
  <!--           AMCL            -->
  <!-- ========================= -->
  <include file="$(find turtlebot3_navigation)/launch/amcl.launch">
    <arg name="initial_pose_x" value="$(arg initial_pose_x)"/>
    <arg name="initial_pose_y" value="$(arg initial_pose_y)"/>
    <arg name="initial_pose_a" value="$(arg initial_pose_a)"/>
  </include>

  <!-- ========================= -->
  <!--        MOVE_BASE          -->
  <!-- ========================= -->
  <include file="$(find turtlebot3_navigation)/launch/move_base.launch">
    <arg name="model" value="$(arg model)"/>
    <arg name="move_forward_only" value="$(arg move_forward_only)"/>
  </include>

  <!-- ========================= -->
  <!--   TON PLANNER PYTHON     -->
  <!-- ========================= -->
  <node pkg="custom_planners" type="planner_node.py" name="planner" output="screen">
      <param name="algorithm" value="$(arg algorithm)"/>
  </node>

  <!-- ========================= -->
  <!--           RVIZ            -->
  <!-- ========================= -->
  <group if="$(arg open_rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find turtlebot3_navigation)/rviz/turtlebot3_navigation.rviz"/>
  </group>

</launch>
